# SECURITY: Copy this file to .env and fill in YOUR actual values
# .env will be ignored by git (it's in .gitignore) - NEVER commit it!
# NEVER share your .env file - it contains your real API keys and passwords

# ============================================================================
# REQUIRED: Gmail Configuration (needed for sending emails)
# ============================================================================
# For GMAIL_USER: use your actual Gmail address
# For GMAIL_PASSWORD: DO NOT use your regular Gmail password
#   Instead, create an "App Password":
#   1. Enable 2-Factor Authentication: https://myaccount.google.com/security
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Select "Mail" and "Windows Computer" (or your device)
#   4. Copy the 16-character password generated
GMAIL_USER=your_actual_email@gmail.com
GMAIL_PASSWORD=your_16_character_app_password

# ============================================================================
# REQUIRED: NASA API Key (needed for space news feature)
# ============================================================================
# Get free API key from: https://api.nasa.gov
# Sign up with your email, they'll send you an API key instantly
NASA_API_KEY=your_nasa_api_key_here

# ============================================================================
# OPTIONAL: OpenWeatherMap API Key (for weather improvements in Phase 1)
# ============================================================================
# Get free API key from: https://openweathermap.org/api
# Free tier includes current weather and forecasts
OPENWEATHER_API_KEY=your_openweather_key_here

# ============================================================================
# OPTIONAL: Your Location (for weather lookups)
# ============================================================================
# Latitude and Longitude for your city
# Default coordinates are Delhi - update these for your location
WEATHER_LAT=28.5161
WEATHER_LON=77.2944

# ============================================================================
# OPTIONAL: Personalization
# ============================================================================
# What Jarvis should call you
USER_NAME=Boss
